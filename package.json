{
  "name": "vexboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
